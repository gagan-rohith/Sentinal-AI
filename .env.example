# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=var/sentinel.db

# Comma separated role:sha256 pairs. Generate each with: python -m auth.api_keys <role>
# Roles: viewer, operator, admin
API_KEYS=

TOOL_TIMEOUT_SECONDS=5

# Search. Use SEARCH_BACKEND=memory to run without Elasticsearch.
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=sentinel-knowledge
AUTO_INDEX=true

# sentence-transformers (default, needs the ml extra) or hash (no model download, not semantic)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional cross-encoder reranker, for example cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=
